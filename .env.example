# Set these only when the production domain / accounts are available.
# NEXT_PUBLIC_SITE_URL=https://your-real-domain.com
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GOOGLE_SITE_VERIFICATION=your-search-console-verification-token

# Server-only credentials. Never use NEXT_PUBLIC_ for these values.
# RESEND_API_KEY=
# INTAKE_FROM_EMAIL=Career Compass <enquiries@your-verified-domain.example>
# TURNSTILE_SECRET_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=your-enabled-structured-output-model
# Public widget key; configure each preview hostname in Turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
